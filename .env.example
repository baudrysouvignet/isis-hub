# Pour compose.yaml (déploiement autonome avec Caddy). Copier en .env.
DOMAIN=hub.exemple.fr
# Identifiants universitaires administrateurs, séparés par des virgules (vérifiés par le CAS).
ADMIN_USERS=lmartin
# Secret du coffre anonyme : « openssl rand -base64 48 », une fois, jamais changé (voir README).
VAULT_PEPPER=
# Images du TCG dans Cloudflare R2 (facultatif, voir .env.example.prod).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
