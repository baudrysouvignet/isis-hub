#!/usr/bin/env bash
# Construit l'image Docker d'ISIS Hub.
#
#   ./build              image pour Linux x86 (amd64) ET Linux ARM (arm64), envoyée sur
#                        ghcr.io/baudrysouvignet/isis-hub:<version> et :latest
#   ./build 1.2.0        idem, avec la version choisie (sinon : date du jour, ex. 2026.11.17-1530)
#   ./build --local      image pour CETTE machine seulement, gardée dans le Docker local, rien
#                        n'est envoyé : pour construire directement sur le VPS, ou tester sur le Mac
#
# Le Mac (Apple Silicon) fait tourner les conteneurs Linux ARM : l'image arm64 est celle du Mac.
# La compilation est croisée (Go), sans émulation : rapide sur Mac comme sur un VPS x86 ou ARM.
#
# Fonctionne sur macOS et Linux. Seul Docker est nécessaire : les tests du serveur tournent dans la
# construction de l'image (une image ne sort que s'ils passent). Go et Node, s'ils sont installés,
# relancent aussi les tests avant.
#
# Envoi sur ghcr.io : se connecter une fois avec un jeton GitHub (droits write:packages et
# read:packages), à coller quand Docker demande « Password » :
#   docker login ghcr.io -u baudrysouvignet
set -euo pipefail
cd "$(dirname "$0")"

IMAGE="ghcr.io/baudrysouvignet/isis-hub"
LOCAL=0
VERSION=""
for arg in "$@"; do
  case "$arg" in
    --local) LOCAL=1 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    -*) echo "Option inconnue : $arg (voir ./build --help)" >&2; exit 2 ;;
    *) VERSION="$arg" ;;
  esac
done
VERSION="${VERSION:-$(date +%Y.%m.%d-%H%M)}"

command -v docker >/dev/null || { echo "Docker est nécessaire." >&2; exit 1; }

# Tests sur la machine, si les outils sont là (sinon, seuls ceux de l'image tournent).
if command -v go >/dev/null; then
  echo "▸ Tests du serveur (Go)"
  go test ./...
  # Failles connues de Go et des dépendances (outil officiel, s'il est installé :
  # go install golang.org/x/vuln/cmd/govulncheck@latest).
  if command -v govulncheck >/dev/null; then
    echo "▸ Failles connues (govulncheck)"
    govulncheck ./...
  fi
fi
if command -v node >/dev/null; then
  echo "▸ Tests de la page (Node)"
  node --test test/*.test.js
fi

LABELS=(
  --label "org.opencontainers.image.source=https://github.com/baudrysouvignet/isis-hub"
  --label "org.opencontainers.image.version=$VERSION"
)

if [ "$LOCAL" = 1 ]; then
  echo "▸ Construction de $IMAGE:$VERSION pour cette machine ($(uname -s) $(uname -m)), sans envoi"
  if docker buildx version >/dev/null 2>&1; then
    docker buildx build --load --build-arg VERSION="$VERSION" "${LABELS[@]}" -t "$IMAGE:$VERSION" -t "$IMAGE:latest" .
  else
    DOCKER_BUILDKIT=1 docker build --build-arg VERSION="$VERSION" "${LABELS[@]}" -t "$IMAGE:$VERSION" -t "$IMAGE:latest" .
  fi
  echo
  echo "✓ Image locale : $IMAGE:$VERSION (et :latest)"
  echo "  Lancer : docker compose -f compose.prod.yaml up -d   (sans « pull » : l'image est déjà là)"
  exit 0
fi

# Envoi multi-plateforme : il faut buildx et une connexion à ghcr.io.
docker buildx version >/dev/null 2>&1 || {
  echo "docker buildx est nécessaire pour l'envoi multi-plateforme (inclus dans Docker Desktop ;" >&2
  echo "sur Linux : paquet docker-buildx-plugin). Ou construire sur place : ./build --local" >&2
  exit 1
}
if ! grep -q 'ghcr.io' "$HOME/.docker/config.json" 2>/dev/null; then
  echo "⚠ Pas de connexion à ghcr.io trouvée. Lance d'abord : docker login ghcr.io -u baudrysouvignet" >&2
  echo "  (Password = un jeton GitHub avec write:packages, pas ton mot de passe GitHub)" >&2
fi

BUILDER="isis-hub-builder"
docker buildx inspect "$BUILDER" >/dev/null 2>&1 || docker buildx create --name "$BUILDER" --driver docker-container >/dev/null

PLATFORMS="linux/amd64,linux/arm64"
echo "▸ Construction et envoi de $IMAGE:$VERSION ($PLATFORMS)"
docker buildx build \
  --builder "$BUILDER" \
  --platform "$PLATFORMS" \
  --build-arg VERSION="$VERSION" \
  "${LABELS[@]}" \
  -t "$IMAGE:$VERSION" \
  -t "$IMAGE:latest" \
  --push .

echo
echo "✓ Envoyé : $IMAGE:$VERSION (et :latest), pour Linux x86 et ARM (dont le Mac)"
echo "  Sur le serveur : docker compose -f compose.prod.yaml pull && docker compose -f compose.prod.yaml up -d"
