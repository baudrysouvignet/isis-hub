# Essai local « comme en production » (compose.test.yaml). Copier en .env.test (jamais versionné :
# .gitignore exclut .env.*), puis remplir. Rien ici ne doit être réutilisé en production.

# Ton identifiant universitaire : l'administration (/admin) s'ouvre avec le vrai CAS.
ADMIN_USERS=ton-identifiant

# Secret du coffre et des empreintes des joueurs du TCG, PROPRE À L'ESSAI (pas celui de la
# production) : openssl rand -base64 48
VAULT_PEPPER=

# Images du TCG dans Cloudflare R2 (facultatif). Vides : photos gardées dans le volume de test.
# Conseillé : un seau d'essai distinct (ex. isis-hub-tcg-test) ; le même jeton d'API peut être
# limité aux deux seaux. Vérifier : docker compose -f compose.test.yaml run --rm isis-hub r2check
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
