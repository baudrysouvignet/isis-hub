# Copier en .env à côté de compose.prod.yaml, puis remplir.

# Adresse publique du site, telle que les étudiants la tapent (sans / final).
# Seule cette origine peut utiliser le relais et l'API (protection contre les autres sites).
PUBLIC_ORIGIN=https://isis-hub.baudrysouvignet.fr

# Identifiants universitaires administrateurs, séparés par des virgules.
# L'identité est vérifiée par le CAS de l'université : aucun mot de passe à définir.
# Vide = pas d'administration (la page /admin n'existe pour personne).
ADMIN_USERS=id

# Version de l'image à lancer (affichée par ./build). « latest » = la dernière envoyée.
ISIS_HUB_VERSION=latest

# Limites du relais (facultatif) : connexions WebSocket par visiteur, au total, et connexions
# vers les portails par visiteur.
# MAX_CONNS_PER_IP=8
# MAX_CONNS=2000
# MAX_STREAMS=64
