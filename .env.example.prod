# Copier en .env à côté de compose.prod.yaml, puis remplir.

# Adresse publique du site, telle que les étudiants la tapent (sans / final).
# Seule cette origine peut utiliser le relais et l'API (protection contre les autres sites).
PUBLIC_ORIGIN=https://isis-hub.baudrysouvignet.fr

# Identifiants universitaires administrateurs, séparés par des virgules.
# L'identité est vérifiée par le CAS de l'université : aucun mot de passe à définir.
# Vide = pas d'administration (la page /admin n'existe pour personne).
ADMIN_USERS=id

# Secret du coffre anonyme (sauvegardes des étudiants). OBLIGATOIRE en production : sans lui, une
# copie du dossier de données permettrait de tester des mots de passe hors ligne. Générer une fois
# avec « openssl rand -base64 48 », ne jamais le changer ni le mettre dans le dossier de données.
VAULT_PEPPER=

# Images des cartes du TCG dans Cloudflare R2 (facultatif ; sans ces quatre variables, elles sont
# gardées dans le volume de données). Cloudflare → R2 → Gérer les jetons d'API R2 → jeton
# « Lecture et écriture d'objets » limité au seau. Vérifier : docker compose -f compose.prod.yaml
# run --rm isis-hub r2check
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Version de l'image à lancer (affichée par ./build). « latest » = la dernière envoyée.
ISIS_HUB_VERSION=latest

# Limites du relais (facultatif) : connexions WebSocket par visiteur, au total, et connexions
# vers les portails par visiteur.
# MAX_CONNS_PER_IP=96
# MAX_CONNS=2000
# MAX_STREAMS=16
